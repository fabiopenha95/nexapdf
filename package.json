{
  "name": "nexapdf",
  "version": "0.1.0",
  "description": "Engine independente de renderização HTML/CSS para PDF, em TypeScript, sem dependências de execução.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "example": "node examples/basic.ts",
    "bench": "node --expose-gc benchmarks/basic.ts"
  },
  "keywords": [
    "pdf",
    "html",
    "css",
    "html-to-pdf",
    "renderer",
    "zero-dependencies",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
